DATABASE_URL=postgresql://postgres:postgres@localhost:5432/step_db
PORT=3002

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# كود الدعوة المطلوب لعمل حساب أدمن جديد عبر POST /auth/register
ADMIN_INVITE_CODE=change-me-too

# --- Notifications (Firebase Cloud Messaging) ---
# لو الثلاثة دول فاضيين، الإشعارات بتتسجل in-app بس من غير push حقيقي.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
